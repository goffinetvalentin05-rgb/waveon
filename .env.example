## Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

## App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

## Accès Pro interne (sans Stripe)
# Configurer `public.profiles` (role / plan_override) — voir migration
# `supabase/migrations/20260424180000_profiles_subscription_overrides.sql`
# et le script `supabase/scripts/grant_admin_profile_pro.sql`.

## Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

## Emails (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# optionnels
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_FALLBACK=

## Cron interne
CRON_SECRET=

# Supabase — projet Waevon
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Préfixe des tables métier : wavon (défaut, migrations locales) ou waevon si le projet Supabase utilise waevon_businesses, etc.
NEXT_PUBLIC_WAEVON_DB_TABLE_PREFIX=wavon

# URL publique de l'application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend — emails transactionnels
# Clé API disponible sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Domaine expéditeur vérifié sur Resend
EMAIL_FROM_ADDRESS=noreply@waevon.com
EMAIL_FROM_NAME=Waevon
# Email de réponse par défaut si le commerçant n'a pas renseigné d'email
EMAIL_REPLY_TO_FALLBACK=contact@waevon.com

# Secret pour les appels cron (header x-cron-secret sur POST /api/cron/emails)
CRON_SECRET=

# Stripe — facturation (clés sur https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Secret du webhook (Developers → Webhooks → endpoint https://<domaine>/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Clé publique (côté navigateur, ex. init Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs mensuels (Products → chaque prix, copier l’id price_…)
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
